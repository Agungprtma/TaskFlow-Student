{
  "name": "taskfocus-student",
  "version": "0.1.0",
  "description": "Platform produktivitas akademik untuk mahasiswa mengelola tugas kuliah",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:setup": "prisma generate && prisma migrate dev && node prisma/seed.js"
  },
  "keywords": [
    "productivity",
    "task-management",
    "students",
    "priority-scoring"
  ],
  "author": "TaskFocus Student",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "body-parser": "^1.20.2"
  },
  "devDependencies": {
    "prisma": "^5.7.1",
    "nodemon": "^3.0.2"
  }
}
